# =============================================================================
# SLAAC Voyages — Variables d'environnement
# =============================================================================
# Copiez ce fichier en `.env.local` (développement) et renseignez les valeurs.
# Sur Vercel : Settings → Environment Variables.
#
# RÈGLES :
# - Ne JAMAIS committer `.env.local` (vérifié par .gitignore).
# - Les clés SENSIBLES ne portent jamais le préfixe NEXT_PUBLIC_ : ce préfixe
#   expose la valeur dans le bundle client. Tout ce qui est ci-dessous sans
#   préfixe NEXT_PUBLIC_ n'est lisible que côté serveur (routes API).
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — configuration publique (identifiants web, non secrets par design)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=votre-cle-api-web-firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Firebase Admin — OBLIGATOIRE EN PRODUCTION
# JSON complet du compte de service (Firebase Console → Paramètres du projet →
# Comptes de service → Générer une nouvelle clé privée), sur une seule ligne.
# Sans cette clé, les routes admin et l'écriture analytics échouent en prod.
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# -----------------------------------------------------------------------------
# Rôles administrateur
# Liste d'emails autorisés (séparés par des virgules), en complément du custom
# claim { admin: true } (voir scripts/set-admin-claim.mjs). L'email doit être
# vérifié. Le custom claim reste le mécanisme recommandé.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=mouhopap@gmail.com

# -----------------------------------------------------------------------------
# Cloudinary — gestion des images
# cloud_name est public ; API key/secret restent côté serveur (upload et
# suppression passent par /api/cloudinary-upload et /api/cloudinary-delete).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=votre-api-secret

# -----------------------------------------------------------------------------
# Assistant IA (chatbot) — OpenRouter
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Formulaire de devis (/api/quotes)
# -----------------------------------------------------------------------------
# Clé SECRÈTE reCAPTCHA (vérification serveur). La clé de site (publique) est
# câblée dans le composant du formulaire.
RECAPTCHA_SECRET=votre-cle-secrete-recaptcha
# SendGrid — notification email à chaque demande de devis
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse destinataire des notifications
NOTIFY_EMAIL=mdslaacvoyages@gmail.com

# -----------------------------------------------------------------------------
# Divers
# -----------------------------------------------------------------------------
# Origine canonique du site (contrôle d'origine du chat, liens email)
NEXT_PUBLIC_BASE_URL=https://slaac-voyages.vercel.app
